# Sync agent configuration. Copy to sync/.env and fill in.
# This file never leaves your laptop and is gitignored.

# --- Supabase -----------------------------------------------------------
# Same values as web/.env. The agent signs in as your normal app user, so it
# is bound by the same row-level security as the website.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# The account you log into the dashboard with.
APP_EMAIL=you@example.com
APP_PASSWORD=your-dashboard-password

# --- Garmin -------------------------------------------------------------
# Your normal Garmin Connect credentials. Tokens are cached in
# sync/.garmin-tokens after the first successful login.
# Leave blank to skip Garmin entirely.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- MyFitnessPal -------------------------------------------------------
# Use a MyFitnessPal password, NOT Google sign-in. Google deliberately refuses
# OAuth from automated browsers ("This browser or app may not be secure"), and
# that is a security control worth respecting rather than defeating.
#
# If you normally sign in with Google you have no password yet: set one at
# myfitnesspal.com/account/forgot_password. Google sign-in keeps working for
# you in a normal browser.
#
# With these set, an expired session repairs itself and no window is ever needed.
MFP_EMAIL=
MFP_PASSWORD=

# Optional: the last part of your MyFitnessPal profile URL. Auto-detected if blank.
MFP_USERNAME=

# --- Behaviour ----------------------------------------------------------
# How many days back to re-sync on each run. Three covers a weekend outage and
# picks up food you logged late.
BACKFILL_DAYS=3

# Used to decide which intraday step buckets fall before the morning deadline.
TIMEZONE=America/Chicago

# Set to 0 to watch the browser work, which is useful when debugging MFP.
HEADLESS=1
