# Copy to .env and fill in from your Supabase project settings (API section).
# Both values are safe to expose in the built bundle: the anon key is a public
# identifier, and every table is protected by row-level security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base path for GitHub Pages. Must match your repository name, with slashes.
# Set to / if you deploy to a root domain or a user/organisation site.
VITE_BASE_PATH=/fitness-dashboard/
