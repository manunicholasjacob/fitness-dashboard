# Cloudflare Pages security headers.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  X-Robots-Tag: noindex, nofollow, noarchive

# Fingerprinted bundles never change under the same name, so cache them hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The shell and the service worker must always be revalidated, or a deploy
# would not reach a device that already has the old one.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
